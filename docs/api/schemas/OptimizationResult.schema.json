{
  "$defs": {
    "AuditEvent": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "outcome": {
          "title": "Outcome",
          "type": "string"
        },
        "sequence": {
          "title": "Sequence",
          "type": "integer"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "subject_id": {
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "sequence",
        "stage",
        "subject_id",
        "outcome",
        "detail"
      ],
      "title": "AuditEvent",
      "type": "object"
    },
    "BacktestMetrics": {
      "additionalProperties": false,
      "properties": {
        "annual_volatility": {
          "minimum": 0,
          "title": "Annual Volatility",
          "type": "number"
        },
        "cagr": {
          "title": "Cagr",
          "type": "number"
        },
        "max_drawdown": {
          "maximum": 1,
          "minimum": 0,
          "title": "Max Drawdown",
          "type": "number"
        },
        "sharpe_ratio": {
          "title": "Sharpe Ratio",
          "type": "number"
        },
        "sortino_ratio": {
          "title": "Sortino Ratio",
          "type": "number"
        },
        "total_fees": {
          "minimum": 0,
          "title": "Total Fees",
          "type": "number"
        },
        "turnover": {
          "minimum": 0,
          "title": "Turnover",
          "type": "number"
        }
      },
      "required": [
        "cagr",
        "sharpe_ratio",
        "sortino_ratio",
        "max_drawdown",
        "annual_volatility",
        "turnover",
        "total_fees"
      ],
      "title": "BacktestMetrics",
      "type": "object"
    },
    "BacktestResult": {
      "additionalProperties": false,
      "properties": {
        "dataset_split": {
          "enum": [
            "train",
            "validation",
            "test"
          ],
          "title": "Dataset Split",
          "type": "string"
        },
        "metrics": {
          "anyOf": [
            {
              "$ref": "#/$defs/BacktestMetrics"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "strategy_id": {
          "title": "Strategy Id",
          "type": "string"
        },
        "strategy_role": {
          "enum": [
            "user",
            "baseline_b1",
            "baseline_b2",
            "baseline_b3",
            "baseline_b4",
            "candidate"
          ],
          "title": "Strategy Role",
          "type": "string"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "strategy_id",
        "strategy_role",
        "status",
        "dataset_split",
        "provider"
      ],
      "title": "BacktestResult",
      "type": "object"
    },
    "BaselineAnalysis": {
      "additionalProperties": false,
      "properties": {
        "design_priorities": {
          "items": {
            "type": "string"
          },
          "title": "Design Priorities",
          "type": "array"
        },
        "evidence_run_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Run Ids",
          "type": "array"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/MetricObservation"
          },
          "title": "Observations",
          "type": "array"
        }
      },
      "required": [
        "evidence_run_ids",
        "observations",
        "design_priorities"
      ],
      "title": "BaselineAnalysis",
      "type": "object"
    },
    "CandidateDecision": {
      "additionalProperties": false,
      "properties": {
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "verdict": {
          "enum": [
            "accept",
            "reject"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "verdict",
        "reason_codes"
      ],
      "title": "CandidateDecision",
      "type": "object"
    },
    "CandidateProposal": {
      "additionalProperties": false,
      "properties": {
        "candidate_type": {
          "enum": [
            "traditional",
            "ml",
            "hybrid"
          ],
          "title": "Candidate Type",
          "type": "string"
        },
        "changed_paths": {
          "items": {
            "type": "string"
          },
          "title": "Changed Paths",
          "type": "array"
        },
        "design_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Design Reasons",
          "type": "array"
        },
        "expected_tradeoffs": {
          "items": {
            "type": "string"
          },
          "title": "Expected Tradeoffs",
          "type": "array"
        },
        "spec": {
          "$ref": "#/$defs/StrategySpec"
        }
      },
      "required": [
        "candidate_type",
        "spec",
        "changed_paths",
        "design_reasons",
        "expected_tradeoffs"
      ],
      "title": "CandidateProposal",
      "type": "object"
    },
    "CandidateRun": {
      "additionalProperties": false,
      "properties": {
        "backtest_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/BacktestResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "candidate_type": {
          "enum": [
            "traditional",
            "ml",
            "hybrid"
          ],
          "title": "Candidate Type",
          "type": "string"
        },
        "code_validation": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeValidationResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/CandidateDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "generated_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeneratedCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "proposal": {
          "$ref": "#/$defs/CandidateProposal"
        },
        "risk_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/RiskReview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "state": {
          "enum": [
            "accepted",
            "rejected_by_validation",
            "rejected_by_risk",
            "rejected_by_code",
            "rejected_after_backtest"
          ],
          "title": "State",
          "type": "string"
        },
        "validation_errors": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Validation Errors",
          "type": "array"
        }
      },
      "required": [
        "candidate_type",
        "state",
        "proposal"
      ],
      "title": "CandidateRun",
      "type": "object"
    },
    "CodeValidationResult": {
      "additionalProperties": false,
      "properties": {
        "errors": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "valid"
      ],
      "title": "CodeValidationResult",
      "type": "object"
    },
    "ExecutionSpec": {
      "additionalProperties": false,
      "properties": {
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "initial_cash": {
          "default": 100000,
          "exclusiveMinimum": 0,
          "title": "Initial Cash",
          "type": "number"
        },
        "rebalance": {
          "const": "monthly",
          "default": "monthly",
          "title": "Rebalance",
          "type": "string"
        },
        "resolution": {
          "const": "daily",
          "default": "daily",
          "title": "Resolution",
          "type": "string"
        },
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        },
        "top_k": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        }
      },
      "required": [
        "start_date",
        "end_date"
      ],
      "title": "ExecutionSpec",
      "type": "object"
    },
    "GeneratedCode": {
      "additionalProperties": false,
      "properties": {
        "generator": {
          "title": "Generator",
          "type": "string"
        },
        "language": {
          "const": "python",
          "default": "python",
          "title": "Language",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "spec_sha256": {
          "title": "Spec Sha256",
          "type": "string"
        },
        "strategy_id": {
          "title": "Strategy Id",
          "type": "string"
        }
      },
      "required": [
        "strategy_id",
        "generator",
        "source",
        "sha256",
        "spec_sha256"
      ],
      "title": "GeneratedCode",
      "type": "object"
    },
    "HybridLogic": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "hybrid",
          "default": "hybrid",
          "title": "Kind",
          "type": "string"
        },
        "ml": {
          "$ref": "#/$defs/MLLogic"
        },
        "traditional": {
          "$ref": "#/$defs/TraditionalLogic"
        },
        "traditional_weight": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Traditional Weight",
          "type": "number"
        }
      },
      "required": [
        "traditional",
        "ml",
        "traditional_weight"
      ],
      "title": "HybridLogic",
      "type": "object"
    },
    "MLLogic": {
      "additionalProperties": false,
      "properties": {
        "feature_set_version": {
          "title": "Feature Set Version",
          "type": "string"
        },
        "kind": {
          "const": "ml",
          "default": "ml",
          "title": "Kind",
          "type": "string"
        },
        "model": {
          "enum": [
            "gradient_boosting",
            "random_forest"
          ],
          "title": "Model",
          "type": "string"
        },
        "prediction_horizon_days": {
          "maximum": 63,
          "minimum": 1,
          "title": "Prediction Horizon Days",
          "type": "integer"
        },
        "random_seed": {
          "title": "Random Seed",
          "type": "integer"
        },
        "task": {
          "enum": [
            "relative_alpha_regression",
            "direction_classification"
          ],
          "title": "Task",
          "type": "string"
        },
        "training_window_days": {
          "maximum": 2520,
          "minimum": 252,
          "title": "Training Window Days",
          "type": "integer"
        }
      },
      "required": [
        "model",
        "task",
        "training_window_days",
        "prediction_horizon_days",
        "feature_set_version",
        "random_seed"
      ],
      "title": "MLLogic",
      "type": "object"
    },
    "MetricObservation": {
      "additionalProperties": false,
      "properties": {
        "interpretation": {
          "title": "Interpretation",
          "type": "string"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "strategy_id": {
          "title": "Strategy Id",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "strategy_id",
        "value",
        "interpretation"
      ],
      "title": "MetricObservation",
      "type": "object"
    },
    "RiskConstraints": {
      "additionalProperties": false,
      "properties": {
        "long_only": {
          "const": true,
          "default": true,
          "title": "Long Only",
          "type": "boolean"
        },
        "max_drawdown_limit": {
          "default": 0.25,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Max Drawdown Limit",
          "type": "number"
        },
        "max_leverage": {
          "const": 1.0,
          "default": 1.0,
          "title": "Max Leverage",
          "type": "number"
        },
        "max_position_weight": {
          "default": 0.35,
          "exclusiveMinimum": 0,
          "maximum": 0.35,
          "title": "Max Position Weight",
          "type": "number"
        }
      },
      "title": "RiskConstraints",
      "type": "object"
    },
    "RiskReview": {
      "additionalProperties": false,
      "properties": {
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "reviewed_strategy_id": {
          "title": "Reviewed Strategy Id",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "approve",
            "reject"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "verdict",
        "reviewed_strategy_id"
      ],
      "title": "RiskReview",
      "type": "object"
    },
    "StrategySpec": {
      "additionalProperties": false,
      "description": "Canonical strategy semantics; this is not the final external DSL.",
      "properties": {
        "candidate_type": {
          "enum": [
            "user",
            "traditional",
            "ml",
            "hybrid"
          ],
          "title": "Candidate Type",
          "type": "string"
        },
        "execution": {
          "$ref": "#/$defs/ExecutionSpec"
        },
        "logic": {
          "discriminator": {
            "mapping": {
              "hybrid": "#/$defs/HybridLogic",
              "ml": "#/$defs/MLLogic",
              "traditional": "#/$defs/TraditionalLogic"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TraditionalLogic"
            },
            {
              "$ref": "#/$defs/MLLogic"
            },
            {
              "$ref": "#/$defs/HybridLogic"
            }
          ],
          "title": "Logic"
        },
        "parent_strategy_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Strategy Id"
        },
        "risk": {
          "$ref": "#/$defs/RiskConstraints"
        },
        "schema_version": {
          "const": "0.1-draft",
          "default": "0.1-draft",
          "title": "Schema Version",
          "type": "string"
        },
        "strategy_id": {
          "maxLength": 120,
          "minLength": 3,
          "pattern": "^[a-z0-9][a-z0-9_-]+$",
          "title": "Strategy Id",
          "type": "string"
        },
        "universe": {
          "$ref": "#/$defs/UniverseSpec"
        }
      },
      "required": [
        "strategy_id",
        "candidate_type",
        "universe",
        "execution",
        "risk",
        "logic"
      ],
      "title": "StrategySpec",
      "type": "object"
    },
    "TraditionalLogic": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "traditional",
          "default": "traditional",
          "title": "Kind",
          "type": "string"
        },
        "lookback_days": {
          "maximum": 504,
          "minimum": 20,
          "title": "Lookback Days",
          "type": "integer"
        },
        "signal": {
          "enum": [
            "momentum_rank",
            "mean_reversion_rank"
          ],
          "title": "Signal",
          "type": "string"
        }
      },
      "required": [
        "signal",
        "lookback_days"
      ],
      "title": "TraditionalLogic",
      "type": "object"
    },
    "UniverseSpec": {
      "additionalProperties": false,
      "properties": {
        "symbols": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 10,
          "title": "Symbols",
          "type": "array"
        },
        "whitelist_version": {
          "default": "whitelist_v1.0",
          "title": "Whitelist Version",
          "type": "string"
        }
      },
      "required": [
        "symbols"
      ],
      "title": "UniverseSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis": {
      "$ref": "#/$defs/BaselineAnalysis"
    },
    "audit_log": {
      "items": {
        "$ref": "#/$defs/AuditEvent"
      },
      "title": "Audit Log",
      "type": "array"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/CandidateRun"
      },
      "title": "Candidates",
      "type": "array"
    },
    "optimization_id": {
      "title": "Optimization Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "optimization_id",
    "status",
    "analysis",
    "candidates",
    "audit_log"
  ],
  "title": "OptimizationResult",
  "type": "object"
}
