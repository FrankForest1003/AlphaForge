{
  "$defs": {
    "ExecutionChanges": {
      "additionalProperties": false,
      "properties": {
        "regime_filter": {
          "anyOf": [
            {
              "enum": [
                "none",
                "benchmark_sma"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Regime Filter"
        },
        "regime_lookback_days": {
          "anyOf": [
            {
              "maximum": 300,
              "minimum": 50,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Regime Lookback Days"
        },
        "target_gross": {
          "anyOf": [
            {
              "maximum": 0.95,
              "minimum": 0.25,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Gross"
        },
        "top_k": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top K"
        }
      },
      "title": "ExecutionChanges",
      "type": "object"
    },
    "HybridLogic": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "hybrid",
          "default": "hybrid",
          "title": "Kind",
          "type": "string"
        },
        "ml": {
          "$ref": "#/$defs/MLLogic"
        },
        "traditional": {
          "$ref": "#/$defs/TraditionalLogic"
        },
        "traditional_weight": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Traditional Weight",
          "type": "number"
        }
      },
      "required": [
        "traditional",
        "ml",
        "traditional_weight"
      ],
      "title": "HybridLogic",
      "type": "object"
    },
    "MLLogic": {
      "additionalProperties": false,
      "properties": {
        "feature_set_version": {
          "title": "Feature Set Version",
          "type": "string"
        },
        "kind": {
          "const": "ml",
          "default": "ml",
          "title": "Kind",
          "type": "string"
        },
        "model": {
          "enum": [
            "gradient_boosting",
            "random_forest"
          ],
          "title": "Model",
          "type": "string"
        },
        "prediction_horizon_days": {
          "maximum": 63,
          "minimum": 1,
          "title": "Prediction Horizon Days",
          "type": "integer"
        },
        "random_seed": {
          "title": "Random Seed",
          "type": "integer"
        },
        "task": {
          "enum": [
            "relative_alpha_regression",
            "direction_classification"
          ],
          "title": "Task",
          "type": "string"
        },
        "training_window_days": {
          "maximum": 2520,
          "minimum": 252,
          "title": "Training Window Days",
          "type": "integer"
        }
      },
      "required": [
        "model",
        "task",
        "training_window_days",
        "prediction_horizon_days",
        "feature_set_version",
        "random_seed"
      ],
      "title": "MLLogic",
      "type": "object"
    },
    "RiskChanges": {
      "additionalProperties": false,
      "description": "No risk-policy changes are permitted in the first contract version.",
      "properties": {},
      "title": "RiskChanges",
      "type": "object"
    },
    "TraditionalLogic": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "traditional",
          "default": "traditional",
          "title": "Kind",
          "type": "string"
        },
        "lookback_days": {
          "maximum": 504,
          "minimum": 20,
          "title": "Lookback Days",
          "type": "integer"
        },
        "signal": {
          "enum": [
            "momentum_rank",
            "mean_reversion_rank"
          ],
          "title": "Signal",
          "type": "string"
        }
      },
      "required": [
        "signal",
        "lookback_days"
      ],
      "title": "TraditionalLogic",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_type": {
      "enum": [
        "traditional",
        "ml",
        "hybrid"
      ],
      "title": "Candidate Type",
      "type": "string"
    },
    "design_reasons": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Design Reasons",
      "type": "array"
    },
    "execution_changes": {
      "$ref": "#/$defs/ExecutionChanges"
    },
    "expected_tradeoffs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Expected Tradeoffs",
      "type": "array"
    },
    "logic": {
      "discriminator": {
        "mapping": {
          "hybrid": "#/$defs/HybridLogic",
          "ml": "#/$defs/MLLogic",
          "traditional": "#/$defs/TraditionalLogic"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/TraditionalLogic"
        },
        {
          "$ref": "#/$defs/MLLogic"
        },
        {
          "$ref": "#/$defs/HybridLogic"
        }
      ],
      "title": "Logic"
    },
    "risk_changes": {
      "$ref": "#/$defs/RiskChanges"
    }
  },
  "required": [
    "candidate_type",
    "logic",
    "execution_changes",
    "risk_changes",
    "design_reasons",
    "expected_tradeoffs"
  ],
  "title": "CandidateDesign",
  "type": "object"
}
