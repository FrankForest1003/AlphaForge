# Local API bind. Keep 127.0.0.1 unless you deliberately add TLS and network controls.
ALPHAFORGE_PORT=18081
ALPHAFORGE_API_TOKEN=replace-with-a-long-random-local-token
RUNTIME_VERSION=1.1.3

# Reproducible LEAN source revision used by the tested v1.1.3 image.
LEAN_REF=0269115d3cfbf691c7a0b7cfcc9ed412cafb91f6

# Each user must supply their own Tiingo token. Real market data is not distributed in this ZIP.
TIINGO_API_TOKEN=replace-with-your-own-tiingo-token
TIINGO_START_DATE=2014-01-01

# Sample data is disabled for the production 30-stock runtime.
ALPHAFORGE_AUTO_GENERATE_SAMPLE_DATA=false
