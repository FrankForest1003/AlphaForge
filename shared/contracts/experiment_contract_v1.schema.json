{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alphaforge.local/contracts/experiment_contract_v1.schema.json",
  "title": "AlphaForge ExperimentContract v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "universe_id", "universe_version", "symbols",
    "start_date", "end_date", "initial_cash", "resolution",
    "rebalance_frequency", "top_k", "target_gross", "max_position_weight",
    "max_drawdown", "transaction_cost_bps", "slippage_bps", "long_only",
    "max_leverage", "cash_allowed", "benchmark", "risk_filter_symbol",
    "risk_sma_period", "data_version", "random_seed"
  ],
  "properties": {
    "contract_version": {"const": "1.0"},
    "universe_id": {"const": "alphaforge_us_equity_30_v1.0"},
    "universe_version": {"const": "whitelist_v1.0"},
    "symbols": {
      "type": "array",
      "minItems": 5,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "start_date": {"type": "string", "format": "date"},
    "end_date": {"type": "string", "format": "date"},
    "initial_cash": {"type": "number", "exclusiveMinimum": 0},
    "resolution": {"const": "Daily"},
    "rebalance_frequency": {"const": "Monthly"},
    "top_k": {"type": "integer", "minimum": 1, "maximum": 10},
    "target_gross": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "max_position_weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "max_drawdown": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "transaction_cost_bps": {"type": "number", "minimum": 0, "maximum": 100},
    "slippage_bps": {"type": "number", "minimum": 0, "maximum": 100},
    "long_only": {"const": true},
    "max_leverage": {"const": 1.0},
    "cash_allowed": {"const": true},
    "benchmark": {"const": "SPY"},
    "risk_filter_symbol": {"const": "QQQ"},
    "risk_sma_period": {"type": "integer", "minimum": 20, "maximum": 500},
    "data_version": {"type": "string", "minLength": 1},
    "random_seed": {"type": "integer", "minimum": 0}
  }
}
